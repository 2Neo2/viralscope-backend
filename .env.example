# Шаблон переменных окружения. Скопируйте в .env и поменяйте значения под себя:
#   cp .env.example .env
# Файл .env в git не попадает. Здесь — только безопасные значения для разработки.

# dev | test | prod. В prod закрыта документация /docs, логи в JSON
VS_ENV=dev
# Имя процесса в логах: api, worker, beat
VS_SERVICE=api
VS_APP_NAME=ViralScope API
VS_VERSION=0.1.0

# DEBUG | INFO | WARNING | ERROR | CRITICAL
VS_LOG_LEVEL=INFO
# Пусто — JSON везде, кроме dev. true/false — принудительно
VS_LOG_JSON=

# Списки — в формате JSON
VS_CORS_ORIGINS=["http://localhost:3000"]

# Внутри docker compose вместо localhost будут имена сервисов: postgres, redis
VS_DATABASE_URL=postgresql+asyncpg://viralscope:viralscope@localhost:5432/viralscope
# Пул соединений с базой. VS_DB_ECHO=true печатает каждый SQL-запрос — только для отладки
VS_DB_ECHO=false
VS_DB_POOL_SIZE=5
VS_DB_MAX_OVERFLOW=10
VS_DB_POOL_TIMEOUT=30
VS_DB_HEALTH_TIMEOUT=2  # секунд на проверку базы в /health/ready
VS_DB_SLOW_QUERY_MS=200  # SQL дольше — в лог как slow_query (0 — выключить)
VS_REDIS_URL=redis://localhost:6379/0

# Тесты базы: по умолчанию база viralscope_test на том же сервере, что VS_DATABASE_URL.
# VS_TEST_DATABASE_URL=postgresql+asyncpg://viralscope:viralscope@localhost:5432/viralscope_test
# VS_TEST_REQUIRE_DB=1  # падать, а не пропускать тесты, если PostgreSQL недоступен (CI)

# --- docker compose ---
# Учётные данные PostgreSQL в контейнере. Для разработки можно оставить как есть,
# на сервере — обязательно свои, длинные и случайные.
POSTGRES_USER=viralscope
POSTGRES_PASSWORD=viralscope
POSTGRES_DB=viralscope

# Порты на вашем компьютере (внутри Docker сервисы всё равно работают на стандартных).
# Поменяйте, если порт занят другим проектом, и не забудьте поправить VS_REDIS_URL / VS_DATABASE_URL выше.
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
GRAFANA_PORT=3001
ALLOY_PORT=12345

# Grafana: логин admin. Обязательно задайте свой пароль — без него docker compose не запустится.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(18))"
GRAFANA_ADMIN_PASSWORD=

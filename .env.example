# Шаблон переменных окружения. Скопируйте в .env и поменяйте значения под себя:
#   cp .env.example .env
# Файл .env в git не попадает. Здесь — только безопасные значения для разработки.

# dev | test | prod. В prod закрыта документация /docs, логи в JSON
VS_ENV=dev
# Имя процесса в логах: api, worker, beat
VS_SERVICE=api
VS_APP_NAME=ViralScope API
VS_VERSION=0.1.0

# DEBUG | INFO | WARNING | ERROR | CRITICAL
VS_LOG_LEVEL=INFO
# Пусто — JSON везде, кроме dev. true/false — принудительно
VS_LOG_JSON=

# Списки — в формате JSON
VS_CORS_ORIGINS=["http://localhost:3000"]

# Внутри docker compose вместо localhost будут имена сервисов: postgres, redis
VS_DATABASE_URL=postgresql+asyncpg://viralscope:viralscope@localhost:5432/viralscope
VS_REDIS_URL=redis://localhost:6379/0
